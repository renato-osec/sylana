+int llvmbpf_vm::set_sbpf_callx_targets(
+	const std::vector<sbpf_callx_target> &targets) noexcept
+{
+	for (const auto &target : targets) {
+		if (target.instruction_pc >= instructions.size()) {
+			error_msg = "sBPF callx target pc is outside loaded code";
+			return -1;
+		}
+	}
+	sbpf_callx_targets = targets;
+	return 0;
+}
+
+int llvmbpf_vm::set_sbpf_version(uint32_t version) noexcept
+{
+	if (version > 2) {
+		error_msg = "Only sBPF versions V0 through V2 are supported";
+		return -EINVAL;
+	}
+	sbpf_version = version;
+	return 0;
+}
+
+int llvmbpf_vm::set_entry_pc(uint32_t instruction_pc) noexcept
+{
+	if (instruction_pc >= instructions.size()) {
+		error_msg = "Entry PC is outside loaded code";
+		return -EINVAL;
+	}
+	entry_pc = instruction_pc;
+	return 0;
+}
+
 void llvmbpf_vm::unload_code() noexcept
 {
 	instructions.clear();
+	sbpf_callx_targets.clear();
+	entry_pc = 0;
 }
 
